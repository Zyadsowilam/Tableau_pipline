# --- Tableau Cloud ---
TABLEAU_SERVER=https://your-pod.online.tableau.com
TABLEAU_SITE=your_site_content_url
TABLEAU_TOKEN_NAME=your_token_name
TABLEAU_TOKEN_SECRET=your_token_secret

# --- SQL Server ---
SQL_SERVER_CONN=mssql+pyodbc://user:pass@server/db?driver=ODBC+Driver+17+for+SQL+Server

# --- Oracle ---
ORACLE_HOST=your_oracle_host
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=your_service_name
ORACLE_USERNAME=your_username
ORACLE_PASSWORD=your_password
# Optional: only needed if using thick-mode Oracle client
ORACLE_CLIENT_LIB_DIR=

# --- Local files ---
HYPER_FILE_PATH=path/to/file.hyper
LOCAL_CSV_PATH=path/to/file.csv
LOCAL_PARQUET_PATH=path/to/file.parquet
